<% layout('layouts/boilerplate') %>

  <div class="container my-5">
    <div class="row justify-content-center">
      <div class="col-lg-9 col-md-10">

        <div class="card shadow-sm border-0 rounded-4 overflow-hidden">

          <div class="card-header bg-white border-0 p-4">
            <h2 class="card-title fw-bold text-primary mb-0">
              <%= listing.title %>
            </h2>
          </div>

          <% if(listing.image && listing.image.length) { %>
            <div id="listingCarousel" class="carousel slide" data-bs-ride="carousel">
              <div class="carousel-indicators">
                <% listing.image.forEach((img, i)=> { %>
                  <button type="button" data-bs-target="#listingCarousel" data-bs-slide-to="<%= i %>"
                    class="<%= i === 0 ? 'active' : '' %>" aria-label="Slide <%= i + 1 %>"></button>
                  <% }) %>
              </div>
              <div class="carousel-inner">
                <% listing.image.forEach((img, i)=> { %>
                  <div class="carousel-item <%= i === 0 ? 'active' : '' %>">
                    <img src="<%= img.url %>" class="d-block w-100 show-page-img" alt="Listing Image">
                  </div>
                  <% }) %>
              </div>
              <button class="carousel-control-prev" type="button" data-bs-target="#listingCarousel"
                data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
              </button>
              <button class="carousel-control-next" type="button" data-bs-target="#listingCarousel"
                data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
              </button>
            </div>
            <% } %>

              <div class="card-body px-4 py-4">
                <h5><i>Posted by: <%= listing.owner.username %></i></h5>
                <h5 class="text-muted mb-3">
                  <i class="fa-solid fa-location-dot me-2 text-danger"></i>
                  <%= listing.location %>, <%= listing.country %>
                </h5>
                <p class="card-text fs-5 text-dark mb-4">
                  <%= listing.description %>
                </p>
                <div class="mb-4">
                  <span class="badge bg-success fs-6 px-3 py-2 shadow-sm">₹ <%= listing.price.toLocaleString('en-IN') %>
                      </span>
                </div>
                <hr>

                <div class="my-4">
                  <h4 class="mb-3">Key Details</h4>
                  <ul class="list-group list-group-flush">
                    <li class="list-group-item"><strong>Purpose:</strong> <span class="badge bg-primary rounded-pill">
                        <%= listing.purpose %>
                      </span></li>
                    <li class="list-group-item"><strong>Usage Category:</strong>
                      <%= listing.usage %>
                    </li>
                    <li class="list-group-item"><strong>Property Type:</strong>
                      <%= listing.propertyType %>
                    </li>

                    <% if (listing.usage==='Residential' && listing.residential) { %>
                      <li class="list-group-item"><strong>Size:</strong>
                        <%= listing.residential.size.toLocaleString('en-IN') %> sqft
                      </li>
                      <li class="list-group-item"><strong>Furnishing:</strong>
                        <%= listing.residential.furnishing %>
                      </li>
                      <% if (listing.residential.amenities && listing.residential.amenities.length> 0) { %>
                        <li class="list-group-item"><strong>Amenities:</strong>
                          <%= listing.residential.amenities.join(', ') %></li>
                <% } %>
              <% } %>
              
              <% if (listing.usage === ' Commercial' && listing.commercial) { %>
                        <li class="list-group-item"><strong>Size:</strong>
                          <%= listing.commercial.size.toLocaleString('en-IN') %> sqft
                        </li>
                        <li class="list-group-item"><strong>Parking Spaces:</strong>
                          <%= listing.commercial.parkingSpaces %>
                        </li>
                        <% if (listing.commercial.amenities && listing.commercial.amenities.length> 0) { %>
                          <li class="list-group-item"><strong>Amenities:</strong>
                            <%= listing.commercial.amenities.join(', ') %></li>
                <% } %>
              <% } %>
              
              <% if (listing.usage === ' Hospitality' && listing.hospitality) { %>
                          <li class="list-group-item"><strong>Rooms:</strong>
                            <%= listing.hospitality.rooms %>
                          </li>
                          <li class="list-group-item"><strong>Star Rating:</strong>
                            <%= listing.hospitality.starRating %> <i class="fa-solid fa-star text-warning"></i>
                          </li>
                          <% if (listing.hospitality.amenities && listing.hospitality.amenities.length> 0) { %>
                            <li class="list-group-item"><strong>Amenities:</strong>
                              <%= listing.hospitality.amenities.join(', ') %></li>
                <% } %>
              <% } %>
              
              <% if (listing.usage === ' Land/Other' && listing.land) { %>
                            <li class="list-group-item"><strong>Plot Size:</strong>
                              <%= listing.land.plotSize.toLocaleString('en-IN') %>
                                <%= listing.land.plotUnit %>
                            </li>
                            <% } %>
                  </ul>
                </div>

                <% if ( currentUser && currentUser._id.equals(listing.owner._id) ) { %>
                  <div class="d-flex justify-content-start flex-wrap gap-3 mt-4">
                    <a href="/listings/<%= listing._id %>/edit" class="btn btn-outline-primary px-4"><i
                        class="fa-solid fa-pen-to-square me-2"></i> Edit</a>
                    <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST"
                      onsubmit="return confirm('Are you sure you want to delete this listing?')">
                      <button class="btn btn-outline-danger px-4"><i class="fa-solid fa-trash-can me-2"></i>
                        Delete</button>
                    </form>
                  </div>
                  <% } %>
              </div>
        </div>
        <hr>
      </div>
    </div>

    <div class="row">
      <div class="col-lg-8 offset-lg-2">
        <% if (currentUser && !currentUser._id.equals(listing.owner._id)) { %>
          <div class="mb-5">
            <hr>
            <h4 class="mt-4">Leave a Review</h4>
            <form action="/listings/<%= listing._id %>/review" method="post" class="needs-validation" novalidate>
              <div class="mb-3">
                <label class="form-label">Rating</label>
                <fieldset class="starability-slot">
                  <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked
                    aria-label="No rating." />
                  <input type="radio" id="first-rate1" name="review[rating]" value="1" /><label for="first-rate1"
                    title="Terrible">1 star</label>
                  <input type="radio" id="first-rate2" name="review[rating]" value="2" /><label for="first-rate2"
                    title="Not good">2 stars</label>
                  <input type="radio" id="first-rate3" name="review[rating]" value="3" /><label for="first-rate3"
                    title="Average">3 stars</label>
                  <input type="radio" id="first-rate4" name="review[rating]" value="4" /><label for="first-rate4"
                    title="Very good">4 stars</label>
                  <input type="radio" id="first-rate5" name="review[rating]" value="5" /><label for="first-rate5"
                    title="Amazing">5 stars</label>
                </fieldset>
              </div>
              <div class="mb-3">
                <label for="comment" class="form-label">Comments</label>
                <textarea name="review[comment]" class="form-control" id="comment" rows="4" required></textarea>
                <div class="invalid-feedback">Please add a comment.</div>
              </div>
              <button type="submit" class="btn btn-outline-dark">Submit</button>
            </form>
          </div>
          <% } %>
            <div class="mb-4">
              <% if(listing.reviews && listing.reviews.length> 0) { %>
                <h4>
                  <i class="fa-solid fa-star text-warning"></i>
                  <% const totalRating=listing.reviews.reduce((sum, review)=> sum + review.rating, 0); %>
                    <% const avgRating=(totalRating / listing.reviews.length).toFixed(1); %>
                      <%= avgRating %> · <%= listing.reviews.length %>
                          <%= listing.reviews.length===1 ? 'Review' : 'Reviews' %>
                </h4>
                <% } else { %>
                  <h4><i class="fa-regular fa-star"></i> No reviews yet</h4>
                  <% } %>
            </div>


            <hr>

            <div class="mt-4">
              <% if (listing.reviews && listing.reviews.length> 0) { %>
                <div class="row">
                  <% for (let review of listing.reviews) { %>
                    <div class="col-12 mb-3">
                      <div class="card">
                        <div class="card-body">
                          <div class="d-flex justify-content-between align-items-center">
                            <h5 class="card-title mb-0">
                              <%= review.author.username %>
                            </h5>
                            <% if( currentUser && currentUser._id.equals(review.author._id) ) { %>
                              <form action="/listings/<%= listing._id %>/review/<%= review._id %>?_method=DELETE"
                                method="post">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                              </form>
                              <% } %>
                          </div>
                          <p class="starability-result" data-rating="<%= review.rating %>">Rated: <%= review.rating %>
                              stars</p>
                          <p class="card-text">
                            <%= review.comment %>
                          </p>
                        </div>
                      </div>
                    </div>
                    <% } %>
                </div>
                <% } else { %>
                  <% if (currentUser && !currentUser._id.equals(listing.owner._id)) { %>
                    <p>Be the first to leave one!</p>
                    <% } else if (!currentUser) { %>
                      <p><a href="/login">Log in</a> to be the first to leave a review!</p>
                      <% } %>
                        <% } %>
            </div>
      </div>
    </div>
  </div>