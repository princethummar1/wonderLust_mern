<% layout('layouts/boilerplate') %>

<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-lg-9 col-md-10">
      <div class="card shadow-sm border-0 rounded-4 overflow-hidden">

        <!-- Listing Image -->
        <div class="image-wrapper">
          <img src="<%= listing.image %>" alt="<%= listing.title %>" class="img-fluid w-100 listing-img">
        </div>

        <!-- Card Content -->
        <div class="card-body px-4 py-4">
          <h2 class="card-title fw-bold text-primary mb-3"><%= listing.title %></h2>

          <h5 class="text-muted mb-3">
            <i class="fa-solid fa-location-dot me-2 text-danger"></i>
            <%= listing.location %>, <%= listing.country %>
          </h5>

          <p class="card-text fs-5 text-dark mb-4"><%= listing.description %></p>

          <div class="mb-4">
            <span class="badge bg-success fs-6 px-3 py-2 shadow-sm">₹ <%= listing.price.toLocaleString('en-IN') %></span>
          </div>

          <!-- Actions -->
          <div class="d-flex justify-content-start flex-wrap gap-3">
            <a href="/listings/<%= listing._id %>/edit" class="btn btn-outline-primary px-4">
              <i class="fa-solid fa-pen-to-square me-2"></i> Edit
            </a>

            <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Are you sure you want to delete this listing?')">
              <button class="btn btn-outline-danger px-4">
                <i class="fa-solid fa-trash-can me-2"></i> Delete
              </button>
            </form>
          </div>
        </div>

      </div>
    </div>
  </div>
</div>
