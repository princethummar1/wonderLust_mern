<% layout('layouts/boilerplate') %>



  <div class="container my-5">
    <div class="row justify-content-center">
      <div class="col-lg-9 col-md-10">
        <div class="card shadow-sm border-0 rounded-4 overflow-hidden">

          <!-- Listing Image -->
          <div class="image-wrapper">
            <h2 class="card-title fw-bold text-primary mb-3">
              <%= listing.title %>
            </h2>
            <img src="<%= listing.image.url %>" alt="<%= listing.title %>" class="img-fluid w-100 listing-img">
          </div>

          <!-- Card Content -->
          <div class="card-body px-4 py-4">
            <h5><i>
                <%= listing.owner.username %>
              </i></h5>
            <h5 class="text-muted mb-3">
              <i class="fa-solid fa-location-dot me-2 text-danger"></i>
              <%= listing.location %>, <%= listing.country %>
            </h5>

            <p class="card-text fs-5 text-dark mb-4">
              <%= listing.description %>
            </p>

            <div class="mb-4">
              <span class="badge bg-success fs-6 px-3 py-2 shadow-sm">₹ <%= listing.price.toLocaleString('en-IN') %>
                  </span>
            </div>

            <!-- Actions -->
            <% if ( currentUser && (currentUser._id.equals(listing.owner._id)) ){ %>
              <div class="d-flex justify-content-start flex-wrap gap-3">
                <a href="/listings/<%= listing._id %>/edit" class="btn btn-outline-primary px-4">
                  <i class="fa-solid fa-pen-to-square me-2"></i> Edit
                </a>

                <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST"
                  onsubmit="return confirm('Are you sure you want to delete this listing?')">
                  <button class="btn btn-outline-danger px-4">
                    <i class="fa-solid fa-trash-can me-2"></i> Delete
                  </button>
                </form>
              </div>
              <% } %>

          </div>

        </div>
        <hr>
        <% if (currentUser){ %>>
          <div class="col-8 offset-3 mb-3">
            <h4>Leave a Review</h4>
            <form action="/listings/<%= listing._id %>/review" method="post">
              <div class="mt-3 mb-3">
                <fieldset class="starability-slot">
                  <legend>First rating:</legend>
                  <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked
                    aria-label="No rating." />
                  <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                  <label for="first-rate1" title="Terrible">1 star</label>
                  <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                  <label for="first-rate2" title="Not good">2 stars</label>
                  <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                  <label for="first-rate3" title="Average">3 stars</label>
                  <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                  <label for="first-rate4" title="Very good">4 stars</label>
                  <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                  <label for="first-rate5" title="Amazing">5 stars</label>
                </fieldset>
              </div>
              <div class="mt-3 mb-3">
                <label for="comment" class="form-label">Comments</label>
                <textarea name="review[comment]" class="form-control" id="comment" cols="30" rows="10"></textarea>
              </div>
              <button type="submit" class="btn btn-outline-dark">Submit</button>
            </form>
          </div>
          <% } %>
            <hr>
            <div class="col-8 offset-3 mb-3">
              <h4>All Reviews</h4>
              <% if (listing.reviews) { %>
                <div class="d-flex flex-wrap  ">
                  <% for (let i=0 ; i< listing.reviews.length ;i++) {%>
                    <div class="card m-3 p-1 ">
                      <div class="card-body">
                        <div class="card-title">
                          <%= listing.reviews[i].author.username %>
                        </div>
                        <p class="starability-result" data-rating="<%= listing.reviews[i].rating %>">
                          Rated: <%= listing.reviews[i].rating %> stars
                        </p>

                        <p>Comment : <%= listing.reviews[i].comment %>
                        </p>
                        <% if( currentUser && (currentUser._id.equals(listing.reviews[i].author._id)) ) { %>
                          <form
                            action="/listings/<%= listing._id %>/review/<%= listing.reviews[i]._id %>?_method=DELETE"
                            method="post">
                            <button type="submit" class="btn btn-dark">Delete</button>
                          </form>
                          <% } %>

                      </div>
                    </div>

                    <% } %>
                </div>

                <% } %>
            </div>
      </div>
    </div>
  </div>

