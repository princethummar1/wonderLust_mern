<% layout('layouts/boilerplate') %>

  <body>
    <div class="container py-5">


      <div class="d-block d-md-flex align-items-md-center gap-md-3 mb-5">

        <div class="filter-carousel-container position-relative flex-grow-1">
          <button class="btn btn-light filter-arrow" id="filter-arrow-left" style="display: none;">
            <i class="fa-solid fa-chevron-left"></i>
          </button>
          <div id="filter-scroll-container" class="d-flex gap-4">

            <a href="/listings/category/Trending" class="filter text-center text-decoration-none text-dark">
              <div><i class="fa-solid fa-fire"></i></div>
              <p>Trending</p>
            </a>
            <a href="/listings/category/Apartment" class="filter text-center text-decoration-none text-dark">
              <div><i class="fa-solid fa-building"></i></div>
              <p>Apartments</p>
            </a>
            <a href="/listings/category/Villa" class="filter text-center text-decoration-none text-dark">
              <div><i class="fa-solid fa-house-chimney-window"></i></div>
              <p>Villas</p>
            </a>
            <a href="/listings/category/Office" class="filter text-center text-decoration-none text-dark">
              <div><i class="fa-solid fa-briefcase"></i></div>
              <p>Office Space</p>
            </a>
            <a href="/listings/category/Hotel" class="filter text-center text-decoration-none text-dark">
              <div><i class="fa-solid fa-hotel"></i></div>
              <p>Hotels</p>
            </a>
            <a href="/listings/category/Amazing Pools" class="filter text-center text-decoration-none text-dark">
              <div><i class="fa-solid fa-person-swimming"></i></div>
              <p>Amazing Pools</p>
            </a>
            <a href="/listings/category/Countryside" class="filter text-center text-decoration-none text-dark">
              <div><i class="fa-solid fa-mountain-sun"></i></div>
              <p>Countryside</p>
            </a>
            <a href="/listings/category/Beachfront" class="filter text-center text-decoration-none text-dark">
              <div><i class="fa-solid fa-umbrella-beach"></i></div>
              <p>Beachfront</p>
            </a>
          </div>
          <button class="btn btn-light filter-arrow" id="filter-arrow-right">
            <i class="fa-solid fa-chevron-right"></i>
          </button>
        </div>

        <div class="filter-button-wrapper mt-3 mt-md-0 ps-md-3 border-md-start">
          <button class="btn btn-outline-dark w-100 w-md-auto" data-bs-toggle="modal"
            data-bs-target="#advancedFilterModal">
            <i class="fa-solid fa-sliders me-2"></i> Filters
          </button>
        </div>
      </div>

      <div class="modal fade" id="advancedFilterModal" tabindex="-1" aria-labelledby="advancedFilterModalLabel"
        aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
          <div class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title" id="advancedFilterModalLabel">Advanced Filters</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form action="/listings/filter" method="GET">
              <div class="modal-body">

                <h6 class="fw-bold mb-3">Price Range</h6>
                <div class="row g-3 mb-4">
                  <div class="col">
                    <label for="minPrice" class="form-label">Min Price</label>
                    <div class="input-group">
                      <span class="input-group-text">₹</span>
                      <input type="number" class="form-control" id="minPrice" name="minPrice" placeholder="0">
                    </div>
                  </div>
                  <div class="col">
                    <label for="maxPrice" class="form-label">Max Price</label>
                    <div class="input-group">
                      <span class="input-group-text">₹</span>
                      <input type="number" class="form-control" id="maxPrice" name="maxPrice" placeholder="50000+">
                    </div>
                  </div>
                </div>
                <hr>

                <h6 class="fw-bold my-3">Property Type</h6>
                <div class="row g-3 mb-4">
                  <div class="col-md-6">
                    <div class="form-check">
                      <input class="form-check-input" type="checkbox" value="Apartment" name="propertyType"
                        id="typeApartment">
                      <label class="form-check-label" for="typeApartment">Apartment</label>
                    </div>
                    <div class="form-check">
                      <input class="form-check-input" type="checkbox" value="Villa" name="propertyType" id="typeVilla">
                      <label class="form-check-label" for="typeVilla">Villa</label>
                    </div>
                    <div class="form-check">
                      <input class="form-check-input" type="checkbox" value="Studio" name="propertyType"
                        id="typeStudio">
                      <label class="form-check-label" for="typeStudio">Studio</label>
                    </div>
                  </div>

                  <div class="col-md-6">
                    <div class="form-check">
                      <input class="form-check-input" type="checkbox" value="Independent House" name="propertyType"
                        id="typeHouse">
                      <label class="form-check-label" for="typeHouse">Independent House</label>
                    </div>
                    <div class="form-check">
                      <input class="form-check-input" type="checkbox" value="Plot" name="propertyType" id="typePlot">
                      <label class="form-check-label" for="typePlot">Plot</label>
                    </div>
                    <div class="form-check">
                      <input class="form-check-input" type="checkbox" value="Office" name="propertyType"
                        id="typeOffice">
                      <label class="form-check-label" for="typeOffice">Office</label>
                    </div>
                  </div>

                  <div class="col-md-6">
                    <div class="form-check">
                      <input class="form-check-input" type="checkbox" value="Shop" name="propertyType" id="typeShop">
                      <label class="form-check-label" for="typeShop">Shop</label>
                    </div>
                    <div class="form-check">
                      <input class="form-check-input" type="checkbox" value="Showroom" name="propertyType"
                        id="typeShowroom">
                      <label class="form-check-label" for="typeShowroom">Showroom</label>
                    </div>
                    <div class="form-check">
                      <input class="form-check-input" type="checkbox" value="Warehouse" name="propertyType"
                        id="typeWarehouse">
                      <label class="form-check-label" for="typeWarehouse">Warehouse</label>
                    </div>
                  </div>

                  <div class="col-md-6">
                    <div class="form-check">
                      <input class="form-check-input" type="checkbox" value="Industrial Unit" name="propertyType"
                        id="typeIndustrial">
                      <label class="form-check-label" for="typeIndustrial">Industrial Unit</label>
                    </div>
                    <div class="form-check">
                      <input class="form-check-input" type="checkbox" value="Hotel" name="propertyType" id="typeHotel">
                      <label class="form-check-label" for="typeHotel">Hotel</label>
                    </div>
                    <div class="form-check">
                      <input class="form-check-input" type="checkbox" value="Resort" name="propertyType"
                        id="typeResort">
                      <label class="form-check-label" for="typeResort">Resort</label>
                    </div>
                  </div>

                  <div class="col-md-6">
                    <div class="form-check">
                      <input class="form-check-input" type="checkbox" value="Guest House" name="propertyType"
                        id="typeGuestHouse">
                      <label class="form-check-label" for="typeGuestHouse">Guest House</label>
                    </div>
                    <div class="form-check">
                      <input class="form-check-input" type="checkbox" value="Hostel" name="propertyType"
                        id="typeHostel">
                      <label class="form-check-label" for="typeHostel">Hostel</label>
                    </div>
                    <div class="form-check">
                      <input class="form-check-input" type="checkbox" value="Service Apartment" name="propertyType"
                        id="typeServiceApartment">
                      <label class="form-check-label" for="typeServiceApartment">Service Apartment</label>
                    </div>
                  </div>

                  <div class="col-md-6">
                    <div class="form-check">
                      <input class="form-check-input" type="checkbox" value="Agricultural Land" name="propertyType"
                        id="typeAgricultural">
                      <label class="form-check-label" for="typeAgricultural">Agricultural Land</label>
                    </div>
                    <div class="form-check">
                      <input class="form-check-input" type="checkbox" value="Co-working" name="propertyType"
                        id="typeCoworking">
                      <label class="form-check-label" for="typeCoworking">Co-working</label>
                    </div>
                    <div class="form-check">
                      <input class="form-check-input" type="checkbox" value="Storage Unit" name="propertyType"
                        id="typeStorage">
                      <label class="form-check-label" for="typeStorage">Storage Unit</label>
                    </div>
                  </div>

                  <div class="col-md-6">
                    <div class="form-check">
                      <input class="form-check-input" type="checkbox" value="Special Purpose" name="propertyType"
                        id="typeSpecialPurpose">
                      <label class="form-check-label" for="typeSpecialPurpose">Special Purpose</label>
                    </div>
                  </div>

                </div>

                <hr>

                <h6 class="fw-bold my-3">Amenities</h6>
                <div class="row g-3">
                  <div class="col-md-4">
                    <div class="form-check"><input class="form-check-input" type="checkbox" value="Pool"
                        name="amenities" id="amenityPool"><label class="form-check-label" for="amenityPool">🏊
                        Pool</label></div>
                    <div class="form-check"><input class="form-check-input" type="checkbox" value="Parking"
                        name="amenities" id="amenityParking"><label class="form-check-label" for="amenityParking">🚗
                        Parking</label></div>
                  </div>
                  <div class="col-md-4">
                    <div class="form-check"><input class="form-check-input" type="checkbox" value="Gym" name="amenities"
                        id="amenityGym"><label class="form-check-label" for="amenityGym">🏋️
                        Gym</label></div>
                    <div class="form-check"><input class="form-check-input" type="checkbox" value="Security"
                        name="amenities" id="amenitySecurity"><label class="form-check-label" for="amenitySecurity">🔒
                        Security</label></div>
                  </div>
                  <div class="col-md-4">
                    <div class="form-check"><input class="form-check-input" type="checkbox" value="Central AC"
                        name="amenities" id="amenityAC"><label class="form-check-label" for="amenityAC">❄️ Central
                        AC</label></div>
                    <div class="form-check"><input class="form-check-input" type="checkbox" value="Power Backup"
                        name="amenities" id="amenityPower"><label class="form-check-label" for="amenityPower">🔋 Power
                        Backup</label></div>
                  </div>
                </div>

              </div>
              <div class="modal-footer">
                <button type="reset" class="btn btn-secondary">Clear Filters</button>
                <button type="submit" class="btn btn-danger">Apply Filters</button>
              </div>
            </form>
          </div>
        </div>
      </div>

      <h1 class="mb-5 text-center fw-bold display-6">Explore Beautiful Stays</h1>
      <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
        <% allListings.forEach(function(listing) { %>
          <div class="col">
            <div class="card listing-card h-100 shadow-sm border-0 rounded-4">
              <a href="/listings/<%= listing._id %>" class="stretched-link"></a>
              <img src="<%= listing.image[0].url %>" class="card-img-top listing-img" alt="<%= listing.title %>">
              <span class="purpose-badge badge position-absolute top-0 start-0 m-2 
  <%= listing.purpose === 'Rent' ? 'rent' : 'sale' %>">
                <%= listing.purpose %>
              </span>


              <div class="card-body d-flex flex-column">
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <h5 class="card-title fw-bold mb-0 text-truncate">
                    <%= listing.title %>
                  </h5>
                  <% if(listing.purpose) { %>
                    <span class="badge text-bg-<%= listing.purpose === 'Rent' ? 'success' : 'danger' %> ms-2">
                      <%= listing.purpose %>
                    </span>
                    <% } %>
                </div>
                <p class="card-text text-muted small mb-2">
                  <i class="fa-solid fa-location-dot me-1"></i>
                  <%= listing.location %>, <%= listing.country %>
                </p>
                <div class="mt-auto">
                  <p class="card-text mb-0">
                    <strong>₹<%= listing.price.toLocaleString("en-IN") %></strong>
                    <% if (listing.purpose==='Rent' ) { %>
                      <% if (listing.usage==='Hospitality' ) { %>
                        / night
                        <% } else { %>
                          / month
                          <% } %>
                            <% } %>
                  </p>
                </div>
              </div>
            </div>
          </div>
          <% }) %>
      </div>
    </div>
  </body>