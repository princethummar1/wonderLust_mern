<% layout('layouts/boilerplate') %>

<body>
  <div class="container py-5">
    <h1 class="mb-5 text-center fw-bold display-6">Explore Beautiful Stays</h1>
    <div class="row g-4">
      <% allListings.forEach(function(listing) { %>
        <div class="col-sm-6 col-md-4 col-lg-3 d-flex">
          <div class="card listing-card shadow-sm border-0 w-100">
            <div class="card-image-wrapper">
              <img src="<%= listing.image.url %>" class="card-img-top listing-img" alt="<%= listing.title %>">
              <div class="price-badge">₹<%= listing.price %></div>
            </div>
            <div class="card-body d-flex flex-column justify-content-between">
              <h5 class="card-title text-truncate"><%= listing.title %></h5>
              <a href="/listings/<%= listing._id %>" class="stretched-link"></a>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</body>
