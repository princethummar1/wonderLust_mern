<% layout('layouts/boilerplate') %>

<body>
  <div class="container py-5">
    <div id="filters" class="d-flex gap-4 ">
      <div class="filter text-center">
        <div>
        <i class="fa-solid fa-fire"></i>
        </div>
        <p>Trending</p>
      </div>
      <div class="filter text-center">
        <div>
        <i class="fa-solid fa-bed"></i>
        </div>
        <p>Rooms</p>
      </div>
      <div class="filter text-center">
        <div>
        <i class="fa-solid fa-mountain-city"></i>
        </div>
        <p>Iconic City</p>
      </div><div class="filter text-center">
        <div>
        <i class="fa-solid fa-fort-awesome"></i>
        </div>
        <p>Castel</p>
      </div><div class="filter text-center">
        <div>
        <i class="fa-solid fa-person-swimming"></i>
        </div>
        <p>Amazing Pools</p>
      </div><div class="filter text-center">
        <div>
        <i class="fa-solid fa-campground"></i>
        </div>
        <p>Camping</p>
      </div>
      <div class="filter text-center">
        <div>
        <i class="fa-solid fa-cow"></i>
        </div>
        <p>Farming</p>
      </div>
      <div class="filter text-center">
        <div>
        <i class="fa-solid fa-snowflake"></i>
        </div>
        <p>Aractic</p>
      </div>
    </div>
    <h1 class="mb-5 text-center fw-bold display-6">Explore Beautiful Stays</h1>
    <div class="row g-4">
      <% allListings.forEach(function(listing) { %>
        <div class="col-sm-6 col-md-4 col-lg-3 d-flex">
          <div class="card listing-card shadow-sm border-0 w-100">
            <div class="card-image-wrapper">
              <img src="<%= listing.image.url %>" class="card-img-top listing-img" alt="<%= listing.title %>">
              <div class="price-badge">₹<%= listing.price %></div>
            </div>
            <div class="card-body d-flex flex-column justify-content-between">
              <h5 class="card-title text-truncate"><%= listing.title %></h5>
              <a href="/listings/<%= listing._id %>" class="stretched-link"></a>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</body>
