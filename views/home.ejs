<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wounderlust - Premium Real Estate</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&family=Playfair+Display:wght@700;800&display=swap" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    
    <style>
        /* --- Reset & Variables --- */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --primary: #D32F2F;        /* Red */
            --primary-hover: #B71C1C;  /* Darker Red */
            --white: #ffffff;
            --text-light: rgba(255, 255, 255, 0.9);
            --glass: rgba(255, 255, 255, 0.1);
            --transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
        }

        body {
            font-family: 'Poppins', sans-serif;
            overflow: hidden; /* Prevents scrolling for a clean one-page look */
            background-color: #000;
        }

        /* --- Background Image & Overlay --- */
        .hero-wrapper {
            position: relative;
            height: 100vh;
            width: 100%;
            background: url('https://images.unsplash.com/photo-1512917774080-9991f1c4c750?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80') no-repeat center center/cover;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* Dark overlay to make text pop */
        .hero-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(to bottom, rgba(0,0,0,0.6), rgba(0,0,0,0.4));
            z-index: 1;
        }

        /* --- Header / Navigation --- */
        header {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            padding: 30px 50px;
            z-index: 100;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-family: 'Playfair Display', serif;
            font-size: 28px;
            font-weight: 700;
            color: var(--white);
            text-decoration: none;
            letter-spacing: 1px;
            position: relative;
        }

        .logo span {
            color: var(--primary);
        }

        .nav-actions {
            display: flex;
            gap: 20px;
            align-items: center;
        }

        .login-link {
            color: var(--white);
            text-decoration: none;
            font-weight: 500;
            font-size: 16px;
            transition: var(--transition);
        }

        .login-link:hover {
            color: var(--primary);
        }

        .signup-btn {
            padding: 10px 25px;
            background: var(--glass);
            border: 1px solid rgba(255,255,255,0.3);
            backdrop-filter: blur(5px);
            color: var(--white);
            text-decoration: none;
            border-radius: 30px;
            font-weight: 500;
            transition: var(--transition);
        }

        .signup-btn:hover {
            background: var(--white);
            color: var(--primary);
        }

        /* --- Main Hero Content --- */
        .hero-content {
            position: relative;
            z-index: 10;
            text-align: center;
            max-width: 900px;
            padding: 0 20px;
        }

        .main-title {
            font-family: 'Playfair Display', serif;
            font-size: 5rem;
            color: var(--white);
            margin-bottom: 20px;
            line-height: 1.1;
            opacity: 0; /* Hidden for JS animation */
            transform: translateY(30px);
        }

        .main-title span {
            color: var(--primary);
            font-style: italic;
        }

        .subtitle {
            font-size: 1.2rem;
            color: var(--text-light);
            margin-bottom: 40px;
            font-weight: 300;
            max-width: 600px;
            margin-left: auto;
            margin-right: auto;
            opacity: 0; /* Hidden for JS animation */
            transform: translateY(20px);
        }

        /* --- CTA Button --- */
        .cta-btn {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 18px 45px;
            background-color: var(--primary);
            color: var(--white);
            text-decoration: none;
            font-size: 18px;
            font-weight: 600;
            border-radius: 50px;
            border: none;
            cursor: pointer;
            transition: var(--transition);
            box-shadow: 0 10px 30px rgba(211, 47, 47, 0.3);
            opacity: 0; /* Hidden for JS animation */
            transform: scale(0.9);
        }

        .cta-btn:hover {
            background-color: var(--primary-hover);
            transform: translateY(-5px);
            box-shadow: 0 20px 40px rgba(211, 47, 47, 0.4);
        }

        .cta-btn i {
            transition: transform 0.3s ease;
        }

        .cta-btn:hover i {
            transform: translateX(5px);
        }

        /* --- Responsive Design --- */
        @media (max-width: 768px) {
            header { padding: 20px; }
            .main-title { font-size: 3.5rem; }
            .subtitle { font-size: 1rem; }
            .signup-btn { display: none; } /* Hide signup on very small screens if needed, or adjust */
        }
    </style>
</head>
<body>

    <div class="hero-wrapper">
        <div class="hero-overlay"></div>

        <header>
            <a href="#" class="logo">Wound<span>erlust</span></a>
            <nav class="nav-actions">
                <a href="/login" class="login-link">Log In</a>
                <a href="/signup" class="signup-btn">Sign Up</a>
            </nav>
        </header>

        <div class="hero-content">
            <h1 class="main-title">Find Your <br> <span>Dream Space</span></h1>
            <p class="subtitle">
                Discover premium properties and exclusive experiences around the globe. 
                Your journey to a better lifestyle begins here.
            </p>
            <a href="#" class="cta-btn">
                Get Started <i class="fas fa-arrow-right"></i>
            </a>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const tl = gsap.timeline({ defaults: { ease: "power3.out" } });

            // Animation Sequence
            tl.from("header", {
                y: -20,
                opacity: 0,
                duration: 1,
                delay: 0.2
            })
            .to(".main-title", {
                y: 0,
                opacity: 1,
                duration: 1.2
            }, "-=0.5")
            .to(".subtitle", {
                y: 0,
                opacity: 1,
                duration: 1
            }, "-=0.8")
            .to(".cta-btn", {
                scale: 1,
                opacity: 1,
                duration: 0.8,
                ease: "back.out(1.7)"
            }, "-=0.6");
        });
    </script>
</body>
</html>
